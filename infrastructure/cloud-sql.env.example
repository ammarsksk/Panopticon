# Copy this file to infrastructure/cloud-sql.env and fill values before running the GCP setup scripts.
# The real cloud-sql.env file is ignored by git through .env* rules.

PROJECT_ID=panopticon-495816
REGION=us-central1
CLOUD_SQL_INSTANCE=panopticon-postgres
CLOUD_SQL_CONNECTION_NAME=panopticon-495816:us-central1:panopticon-postgres
DATABASE_NAME=panopticon
DATABASE_USER=panopticon
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CLOUD_SQL_TIER=db-custom-1-3840
CLOUD_SQL_STORAGE_GB=20
CLOUD_SQL_BACKUP_START_TIME=03:00

BACKEND_DOMAIN=https://YOUR_BACKEND_DOMAIN
FRONTEND_DOMAIN=https://YOUR_FRONTEND_DOMAIN

GITLAB_TOKEN=CHANGE_ME
GITLAB_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GITLAB_OAUTH_CLIENT_ID=CHANGE_ME
GITLAB_OAUTH_CLIENT_SECRET=CHANGE_ME
SLACK_SIGNING_SECRET=CHANGE_ME
SLACK_OAUTH_CLIENT_ID=CHANGE_ME
SLACK_OAUTH_CLIENT_SECRET=CHANGE_ME
OAUTH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
AGENT_RUNTIME_TOKEN=CHANGE_ME_LONG_RANDOM_AGENT_TOKEN

# Optional local migration setting. Download Cloud SQL Auth Proxy and put its path here.
CLOUD_SQL_PROXY_PATH=cloud-sql-proxy.exe
CLOUD_SQL_PROXY_PORT=5433
