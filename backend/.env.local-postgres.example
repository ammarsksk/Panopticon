APP_NAME=Panopticon
APP_ENV=development
DATABASE_URL=postgresql+psycopg://panopticon:panopticon@localhost:5432/panopticon
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

GITLAB_WEBHOOK_SECRET=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=

SLACK_WEBHOOK_URL=

DRY_RUN_ACTIONS=true
DISPATCH_ACTIONS=true

GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=panopticon-495816
GOOGLE_CLOUD_LOCATION=us-central1

