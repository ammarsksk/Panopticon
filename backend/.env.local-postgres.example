APP_NAME=Panopticon
APP_ENV=development
APP_API_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://panopticon:panopticon@localhost:5432/panopticon
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
AUTH_REQUIRED=false
SESSION_COOKIE_NAME=panopticon_session
SESSION_TTL_HOURS=168
DEFAULT_WORKSPACE_SLUG=local-dev
AGENT_RUNTIME_TOKEN=
AGENT_RUNTIME_WORKSPACE_SLUG=local-dev
AGENT_RUNTIME_USER_EMAIL=agent@panopticon.dev
PANOPTICON_API_BASE_URL=http://127.0.0.1:8000
PANOPTICON_AGENT_TOKEN=

GITLAB_WEBHOOK_SECRET=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gitlab/callback
GITLAB_OAUTH_SCOPES=api,read_user
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_TTL_MINUTES=15

SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/slack/callback

DRY_RUN_ACTIONS=true
DISPATCH_ACTIONS=true
REPO_INDEX_ON_SYNC=true
REPO_INDEX_FILE_LIMIT=80
REPO_INDEX_MAX_FILE_BYTES=20000

GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=panopticon-495816
GOOGLE_CLOUD_LOCATION=global
