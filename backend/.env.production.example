APP_NAME=Panopticon
APP_ENV=production
APP_API_URL=https://YOUR_BACKEND_DOMAIN
APP_PUBLIC_URL=https://YOUR_FRONTEND_DOMAIN
DATABASE_URL=postgresql+psycopg://PANOPTICON_DB_USER:PANOPTICON_DB_PASSWORD@PANOPTICON_DB_HOST:5432/PANOPTICON_DB_NAME
ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
AUTH_REQUIRED=true
SESSION_COOKIE_NAME=panopticon_session
SESSION_TTL_HOURS=168
DEFAULT_WORKSPACE_SLUG=production

GITLAB_WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=CHANGE_ME
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/auth/google/callback
GITLAB_OAUTH_CLIENT_ID=CHANGE_ME
GITLAB_OAUTH_CLIENT_SECRET=CHANGE_ME
GITLAB_OAUTH_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/integrations/gitlab/callback
OAUTH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATED_FERNET_KEY
OAUTH_STATE_TTL_MINUTES=15

SLACK_WEBHOOK_URL=CHANGE_ME
SLACK_SIGNING_SECRET=CHANGE_ME
SLACK_BOT_TOKEN=xoxb-CHANGE_ME
SLACK_DEFAULT_CHANNEL=#panopticon
SLACK_OAUTH_CLIENT_ID=CHANGE_ME
SLACK_OAUTH_CLIENT_SECRET=CHANGE_ME
SLACK_OAUTH_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/integrations/slack/callback

DRY_RUN_ACTIONS=true
DISPATCH_ACTIONS=true

GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=panopticon-495816
GOOGLE_CLOUD_LOCATION=global
